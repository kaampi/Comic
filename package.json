{
  "name": "comicbook-ai",
  "version": "0.1.0",
  "description": "ComicBook AI — local-first comic creation workspace.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test:module-paths": "node scripts/test-module-paths.mjs",
    "test:about": "node scripts/test-about.mjs",
    "test:library-drop": "node scripts/test-library-drop.mjs",
    "test:chapters": "node scripts/test-chapters.mjs",
    "test:adaptation": "node scripts/test-adaptation.mjs",
    "test:image-prompts": "node scripts/test-image-prompts.mjs",
    "test:manuscript-ui": "node scripts/test-manuscript-ui.mjs",
    "test:panel-move": "node scripts/test-panel-move.mjs",
    "test:panel-pool": "node scripts/test-panel-pool.mjs",
    "test:foreground": "node scripts/test-foreground.mjs",
    "test:bubble-shape": "node scripts/test-bubble-shape.mjs",
    "test:free-form": "node scripts/test-free-form.mjs",
    "test:export": "node scripts/test-export.mjs",
    "test:export-preflight": "node scripts/test-export-preflight.mjs",
    "test:style-modes": "node scripts/test-style-modes.mjs",
    "test:diagnostics": "node scripts/test-diagnostics.mjs",
    "test:save-errors": "node scripts/test-save-errors.mjs",
    "test:idml": "node scripts/test-idml.mjs",
    "test:page-spacing": "node scripts/test-page-spacing.mjs",
    "test:project-storage": "node scripts/test-project-storage.mjs",
    "test:storage-recovery": "node scripts/test-storage-recovery.mjs",
    "test:backup-reminder": "node scripts/test-backup-reminder.mjs",
    "test:style-organization": "node scripts/test-style-organization.mjs",
    "docs:guide": "node scripts/build-guide.mjs",
    "test:guide": "node scripts/build-guide.mjs --check && node scripts/test-guide.mjs",
    "test:story-workflow": "node scripts/test-story-workflow.mjs",
    "test:project-start": "node scripts/test-project-start.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:info": "tauri info"
  },
  "dependencies": {
    "@ocedo-apps/storycore": "git+https://github.com/ocedo-apps/storycore.git#main",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.3"
  }
}
