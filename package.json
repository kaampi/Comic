{
  "name": "comicbook-ai",
  "version": "0.1.0",
  "description": "ComicBook AI \u2014 local-first comic creation workspace.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test:module-paths": "node scripts/test-module-paths.mjs",
    "test:about": "node scripts/test-about.mjs",
    "test:library-drop": "node scripts/test-library-drop.mjs",
    "test:adaptation": "node scripts/test-adaptation.mjs",
    "test:manuscript-ui": "node scripts/test-manuscript-ui.mjs",
    "test:export": "node scripts/test-export.mjs",
    "test:idml": "node scripts/test-idml.mjs"
  },
  "dependencies": {
    "@ocedo-apps/storycore": "git+https://github.com/ocedo-apps/storycore.git#main",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^26.1.0"
  }
}
